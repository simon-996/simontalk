# Local development only. Never reuse these credentials in production.
SIMONTALK_DATABASE_URL=postgresql+psycopg://simontalk:simontalk@127.0.0.1:54329/simontalk
SIMONTALK_ENVIRONMENT=development
SIMONTALK_COOKIE_SECURE=false
SIMONTALK_ALLOWED_ORIGINS=["http://localhost:7357","http://127.0.0.1:7357"]
# API lifespan runs one bounded preparation/connection cleanup batch per interval.
SIMONTALK_PRACTICE_MAINTENANCE_INTERVAL_SECONDS=15
# Tests require a separate database whose name ends in _test.
SIMONTALK_TEST_DATABASE_URL=postgresql+psycopg://simontalk:simontalk@127.0.0.1:54329/simontalk_test
# Private provider configuration; loading it does not enable gateways or make calls.
SIMONTALK_QWEN_API_KEY=
SIMONTALK_QWEN_WORKSPACE_ID=
SIMONTALK_QWEN_REALTIME_MODEL=qwen3.5-omni-plus-realtime
SIMONTALK_QWEN_CONFIG_ID=qwen-private-v1
# Explicit review opt-in only. Credentials alone never enable generation.
SIMONTALK_REVIEW_PROVIDER=disabled
SIMONTALK_QWEN_ENV_FILE=.env
SIMONTALK_QWEN_REVIEW_MODEL=qwen3.8-flash
SIMONTALK_QWEN_REVIEW_CONFIG_ID=qwen-review-v1
